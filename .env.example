# CekLoker — Contoh variabel lingkungan
# Salin file ini menjadi .env, lalu isi nilainya.
# Jangan pernah commit file .env asli ke repositori.

# Koneksi database Neon Postgres (wajib mulai Fase 1).
# Gunakan connection string pooled (alamat berakhiran -pooler).
DATABASE_URL=

# Kunci Google Gemini untuk fallback ekstraksi AI (opsional).
# Jika kosong, aplikasi memakai ekstraksi berbasis regex.
GEMINI_API_KEY=

# Aktifkan ekstraksi AI: "true"/"1" untuk mengaktifkan, "false"/"0" untuk menonaktifkan.
AI_EXTRACTION_ENABLED=false

# Kredensial admin untuk Fase 5 (panel administrasi).
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
AUTH_SECRET=

# URL publik situs (untuk metadata, canonical URL, dan tautan absolut).
# Produksi (Vercel): https://ceklokerkita.vercel.app — dipakai otomatis
# bila variabel ini tidak diisi. Untuk pengembangan lokal biarkan localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
